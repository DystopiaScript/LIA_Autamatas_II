$ ============================================================
$ 03_entrada_salida.lia
$ Caso valido segun la gramatica actual del proyecto:
$   input  recibe expresiones.
$   output recibe una lista de identificadores.
$
$ Aunque los nombres EST_WRITE y EST_READ puedan parecer invertidos,
$ se conserva exactamente la produccion actual del parser.
$ ============================================================

class ( EntradaSalida ) {

def x : int ;
def y : int ;

input ( x ) ;
input ( x + 10 , x * 2 ) ;
output ( x , y ) ;

}
