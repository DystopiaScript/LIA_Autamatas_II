$ ============================================================
$ 03_entrada_salida.lia
$ Caso valido de entrada y salida:
$   input  recibe identificadores destino.
$   output recibe una expresion.
$
$ La lista de identificadores de input se escribe separada por comas.
$ ============================================================

class ( EntradaSalida ) {

def x : int ;
def y : int ;

input ( x ) ;
input ( x, y ) ;
output ( x + 10 ) ;
output ( x * y ) ;

}
